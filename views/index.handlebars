<h1>Quản lý Sách</h1>
<p>Số lần truy cập (lưu trong session trên Atlas): {{views}}</p>
{{#if flash}}<p style="color:red">{{flash}}</p>{{/if}}

<form method="POST" action="/books" style="margin-bottom:16px">
  <input name="code" placeholder="Mã SP (bắt đầu bằng {{student.PREFIX}})" required>
  <input name="title" placeholder="Tên sách" required>
  <input name="price" type="number" step="0.01" min="0" placeholder="Giá gốc" required>
  <button type="submit">Thêm</button>
</form>

<table border="1" cellpadding="6" cellspacing="0" width="100%">
  <tr><th>Mã</th><th>Tên sách</th><th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th></tr>
  {{#each books}}
  <tr><td>{{code}}</td><td>{{title}}</td><td>{{price}}</td><td>{{vat}}%</td><td>{{priceAfterTax}}</td></tr>
  {{/each}}
</table>